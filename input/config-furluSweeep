meta:
  engine: 4.1.0
units:
  U : 19.05
  cx : 18
  cy : 17
  # Choc Spacing Variables
  kx: cx
  ky: cy
  # Padding Variables
  px: kx + 2
  py: ky +2
  #keycaps size
  keycap_1u_w: 17.5
  keycap_1u_h: 16.6
  keycap_15u_w: 27
  keycap_15u_h: 16.6

  screwSize: 1.5
  #screwsupport: 5

points:
  zones:
    matrix:
      rotate: 18
      key:
        padding: 1ky
        spread: 1kx
      anchor:
        shift: [100, -150]
      columns:
        pinky:
          key:
            spread: ky
        ring:
          key:
            spread: ky
            splay: -10
            stagger: 13
            origin: [0, -8]
        middle:
          key:
            spread: ky
            splay: -5
            stagger: 6.5
            origin: [0, -8.6]
        index:
          key:
            spread: ky
            splay: -3
            stagger: -8
            origin: [0, -1]
        inner:
          key:
            spread: ky
            stagger: -3
      rows:
        bottom:
          spread: kx
        home:
          spread: kx
        top:
          spread: kx
    thumbfan:
      anchor:
        ref: matrix_index_bottom
        shift: [2, -ky-7.5]
        rotate: 8
      columns:
        inner:
          key:
            splay: 0
            origin: [0, 0]
            name: keys_thumb_inner
        home:
          key:
            spread: 18.5
            splay: -12
            origin: [-9.5, -4]
            name: keys_thumb_home
        outer:
          key:
            spread: 18.5
            splay: -8
            origin: [-9.5, -4]
            name: keys_thumb_outer

outlines:
  raw:
    - what: rectangle
      where: true
      size: [px, py]
  keys:
    - what: rectangle
      where: true
      bound: false
      size: [kx-0.5, ky-0.5]
  keycaps:
    - what: rectangle
      where: true
      size: [keycap_1u_w, keycap_1u_h]
  _key_slot_negative:
    - what: rectangle
      where: true
      size: [13.8, 13.8]

  board :
    - what: polygon
      operation: stack
      points:
        - ref: keys_thumb_inner
          shift: [-.5px, .5py+8.6]
        - ref: matrix_ring_bottom
          shift: [-.5px+2, -.5py]
        - ref: matrix_pinky_bottom
          shift: [.5px, -.5py]
        - ref: matrix_pinky_bottom
          shift: [-.5px, -.5py]
        - ref: matrix_pinky_bottom
          shift: [.5px-2, -.5py]
        - ref: matrix_pinky_bottom
          shift: [-.5px, -.5py]
        - ref: matrix_pinky_top
          shift: [-.5px, .5py]
        - ref: matrix_pinky_top
          shift: [-.5px, .5py]
        - ref: matrix_pinky_top
          shift: [.5px+4.7, .5py]
        - ref: matrix_ring_top
          shift: [-.5px, .5py]
        - ref: matrix_middle_top
          shift: [-.5px, .5py-7]
        - ref: matrix_middle_top
          shift: [-.5px, .5py]
        - ref: matrix_middle_top
          shift: [.5px, .5py]
        - ref: matrix_middle_top
          shift: [.5px, .5py-7.5]
        - ref: matrix_index_top
          shift: [.5px, .5py]
        - ref: matrix_inner_top
          shift: [-.5px+2, .5py]
        - ref: matrix_inner_top
          shift: [.5px, .5py]
        - ref: matrix_inner_top
          shift: [.5px, .5py-8]
        - ref: matrix_inner_top
          shift: [.5px+19.32, .5py-8]
        - ref: keys_thumb_outer
          shift: [.5px-4.6, .5py]
        - ref: keys_thumb_outer
          shift: [.5px, .5py]
        - ref: keys_thumb_outer
          shift: [.5px, -.5py]
        - ref: keys_thumb_home
          shift: [.5px, -.5py]
        - ref: keys_thumb_home
          shift: [-.5px, -.5py]
        - ref: keys_thumb_inner
          shift: [-.5px, -.5py]
        - ref: keys_thumb_inner
          shift: [-.5px, .5py]

  _mcu_hole:
    - what: polygon
      operation: stack
      points:
        - ref: matrix_inner_top
          shift: [.5px, .5py]
        - ref: matrix_inner_top
          shift: [.5px+25, .5py]
        - ref: matrix_inner_bottom
          shift: [.5px+20, .5py-4.2]
        - ref: matrix_inner_bottom
          shift: [.5px, .5py-4.2]

  _screwHoles:
    - what: circle
      radius: screwSize
      where:
        - ref: matrix_pinky_top
          shift: [.5px+1.5, .5py-13]
    - what: circle
      radius: screwSize
      where:
        - ref: matrix_pinky_bottom
          shift: [.5px-0.9, .5py-1]
    - what: circle
      radius: screwSize
      where:
        - ref: matrix_middle_top
          shift: [-.5px-0.5, -.5py+1]
    - what: circle
      radius: screwSize
      where:
        - ref: matrix_index_top
          shift: [.5px-1.3, -.5py+1]
    - what: circle
      radius: screwSize
      where:
        - ref: keys_thumb_inner
          shift: [-.5px+20.5, .5py]
    - what: circle
      radius: screwSize
      where:
        - ref: keys_thumb_outer
          shift: [-.5px-0.5, .5py]

  bottom_plate:
    - name : board
      fillet: 1
    - operation: subtract
      name: _screwHoles

  top_plate:
    - name: board
    - operation: subtract
      name: _mcu_hole
      fillet: 1
    - operation: subtract
      name: _key_slot_negative
    - operation: stack
      name: _screwHoles

  plate:
    - name : board
      fillet: 1
    - operation: subtract
      name: _key_slot_negative
    - operation: subtract
      name: _screwHoles

pcbs:
  keyb_pcb:
    template: kicad8
    outlines:
      - outline : bottom_plate
        #layer : Edge.Cuts
    footprints:
      choc_hotswap:
        what: ceoloide/switch_choc_v1_v2
        where: true
        params:
          solder: true
          reversible: true
          hotswap: true
          choc_v2_support: false
          include_corner_marks: true
          keycap_width: 18
          keycap_height: 17
          from: "{{name}}"
          to: GND
      microcontroller:
        what: ceoloide/mcu_nice_nano
        where:
          ref: matrix_inner_home
          shift: [20,1]
          rotate: 0
        params:
          show_instructions: false
          show_silk_labels: false
          show_silk_labels_on_both_sides: false
          show_via_labels: false
          reversible: true
          P4: matrix_pinky_top
          P18: matrix_pinky_home
          P10: matrix_pinky_bottom

          P3: matrix_ring_top
          P5: matrix_ring_home
          P16: matrix_ring_bottom

          P2: matrix_middle_top
          P19: matrix_middle_home
          P14: matrix_middle_bottom

          P0: matrix_index_top
          P20: matrix_index_home
          P15: matrix_index_bottom

          P1: matrix_inner_top
          P21: matrix_inner_home
          P6: matrix_inner_bottom

          P7: keys_thumb_inner
          P8: keys_thumb_home
          P9: keys_thumb_outer
      switch:
        what: ceoloide/power_switch_smd_side
        where: 
          ref: matrix_inner_top
          shift: [-37,-38.4]
          rotate: -82
        params:
          reversible: true
      #trrs:
      #    what: ceoloide/trrs_pj320a
      #    where:
      #      ref: matrix_inner_top
      #      shift: [26.6, -38]
      #      rotate: -90
      #    params:
      #      reversible: true
      batt_plug:
        what: ceoloide/battery_connector_jst_ph_2
        where :
          ref: matrix_inner_bottom
          shift: [13,-5]
          rotate: 90
        params:
          reversible: true

      mouting_holes0:
        what: ceoloide/mounting_hole_plated
        where:
          - ref: matrix_pinky_top
            shift: [.5px+1.5, .5py-13]
      mouting_holes1:
        what: ceoloide/mounting_hole_plated
        where:
          - ref: matrix_pinky_bottom
            shift: [.5px-0.9, .5py-1]
      mouting_holes3:
        what: ceoloide/mounting_hole_plated
        where:
          - ref: keys_thumb_inner
            shift: [-.5px+20.5, .5py]
      mouting_holes4:
        what: ceoloide/mounting_hole_plated
        where:
          - ref: keys_thumb_outer
            shift: [-.5px-0.5, .5py]
      mouting_holes5:
        what: ceoloide/mounting_hole_plated
        where:
          - ref: matrix_index_top
            shift: [.5px-1.3, -.5py+1]
      mouting_holes6:
        what: ceoloide/mounting_hole_plated
        where:
          - ref: matrix_middle_top
            shift: [-.5px-0.5, -.5py+1]

  top_plate_pcb:
    template: kicad8
    outlines:
      - outline : top_plate


  bottom_plate_pcb:
    template: kicad8
    outlines:
      - outline : bottom_plate

cases:
  TopPlate:
    - name: top_plate
      extrude: 1.2
