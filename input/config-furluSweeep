meta:
  engine: 4.1.0
units:
  U : 19.05
  cx : 18
  cy : 17
  # Proxy Spacing Variables
  # MX
  #kx: U
  #ky: U
  # choc
  kx: cx
  ky: cy
  # Padding Variables
  px: kx + 2
  py: ky +2
  #keycaps size
  keycap_1u_w: 17.5
  keycap_1u_h: 16.6
  keycap_15u_w: 27
  keycap_15u_h: 16.6

  screwSize: 1.5
  screwsupport: 5



points:
  zones:
    matrix:
      rotate: 14
      key:
        padding: 1ky
        spread: 1kx
      anchor:
        shift: [100, -150]
      columns:
        pinky:
          key:
            spread: ky
        ring:
          key:
            spread: ky
            splay: -9
            stagger: 10
            origin: [0, -7.8]
        middle:
          key:
            spread: ky
            splay: -2
            stagger: 6.5
            origin: [0, -9]
        index:
          key:
            spread: ky
            splay: -3
            stagger: -8
            origin: [0, -1]
        inner:
          key:
            spread: ky
            stagger: -3
      rows:
        bottom:
          spread: kx
        home:
          spread: kx
        top:
          spread: kx
    thumbfan:
      anchor:
        ref: matrix_index_bottom
        shift: [0, -ky-7]
      columns:
        inner:
          key:
            splay: 0
            origin: [0, 0]
            name: keys_thumb_inner
        home:
          key:
            spread: 18.5
            splay: -12
            origin: [-9.5, -9]
            name: keys_thumb_home
        outer:
          key:
            spread: 18.5
            splay: -12
            origin: [-9.5, -9]
            name: keys_thumb_outer

outlines:
  raw:
    - what: rectangle
      where: true
      size: [px, py]
  keys:
    - what: rectangle
      where: true
      bound: false
      size: [kx-0.5, ky-0.5]
  keycaps:
    - what: rectangle
      where: true
      size: [keycap_1u_w, keycap_1u_h]
  _key_slot_negative:
    - what: rectangle
      where: true
      size: [13.8, 13.8]

  board :
    - what: polygon
      operation: stack
      points:

        - ref: matrix_index_bottom
          shift: [-.5px, -.5py]
        - ref: matrix_middle_bottom
          shift: [.4px, -.5py]
        - ref: matrix_middle_bottom
          shift: [-.4px, -.5py]


        - ref: matrix_ring_bottom
          shift: [.5px, -.5py]
        - ref: matrix_pinky_bottom
          shift: [.5px, .09py]
        - ref: matrix_pinky_bottom
          shift: [.5px, -.5py]
        - ref: matrix_pinky_bottom
          shift: [-.5px, -.5py]
        - ref: matrix_pinky_bottom
          shift: [.5px-2, -.5py]
        - ref: matrix_pinky_bottom
          shift: [-.5px, -.5py]
        - ref: matrix_pinky_top
          shift: [-.5px, .5py]
        - ref: matrix_pinky_top
          shift: [-.5px, .5py]
        - ref: matrix_pinky_top
          shift: [.5px+4.4, .5py]
        - ref: matrix_ring_top
          shift: [-.5px, .5py]
        - ref: matrix_ring_top
          shift: [.5px-0.4, .5py]
        - ref: matrix_middle_top
          shift: [-.5px, .5py]
        - ref: matrix_middle_top
          shift: [.5px, .5py]
        - ref: matrix_middle_top
          shift: [.5px, .5py-7.5]
        - ref: matrix_index_top
          shift: [.5px, .5py]
        - ref: matrix_inner_top
          shift: [-.5px+2, .5py]
        - ref: matrix_inner_top
          shift: [.5px, .5py]
      #middle
        - ref: matrix_inner_top
          shift: [.5px, -.5py]
        - ref: matrix_inner_top
          shift: [.5px+19.32, -.5py]


        - ref: keys_thumb_outer
          shift: [.5px-5, .5py]
        - ref: keys_thumb_outer
          shift: [.5px, .5py]
        - ref: keys_thumb_outer
          shift: [.5px, -.5py]
        - ref: keys_thumb_home
          shift: [.5px, -.5py]
        - ref: keys_thumb_home
          shift: [-.5px, -.5py]
        - ref: keys_thumb_inner
          shift: [-.5px, -.5py]
        - ref: keys_thumb_inner
          shift: [-.5px, .5py]

  board_fillet:
    - name : board
      fillet: 1

  top_plate:
    - name : board
      fillet: 1
    - operation: subtract
      name: keys

pcbs:
  keyb_pcb:
    template: kicad8
    outlines:
      - outline : board_fillet
        #layer : Edge.Cuts
    footprints:
      choc_hotswap:
        what: ceoloide/switch_choc_v1_v2
        where: true
        params:
          reversible: true
          hotswap: true
          choc_v2_support: false
          include_corner_marks: false
          keycap_width: 18
          keycap_height: 17
          from: "{{name}}"
          to: GND
      microcontroller:
        what: ceoloide/mcu_nice_nano
        where:
          ref: matrix_inner_home
          shift: [20,-10]
          rotate: 0
        params:
          reversible: true
          P4: matrix_pinky_top
          P18: matrix_pinky_home
          P10: matrix_pinky_bottom

          P3: matrix_ring_top
          P5: matrix_ring_home
          P16: matrix_ring_bottom

          P2: matrix_middle_top
          P19: matrix_middle_home
          P14: matrix_middle_bottom

          P0: matrix_index_top
          P20: matrix_index_home
          P15: matrix_index_bottom

          P1: matrix_inner_top
          P21: matrix_inner_home
          P6: matrix_inner_bottom

          P7: keys_thumb_inner
          P8: keys_thumb_home
          P9: keys_thumb_outer

          
      switch:
        what: ceoloide/power_switch_smd_side
        where: 
          ref: matrix_inner_top
          shift: [-26,-42.5]
          rotate: 180
        params:
          reversible: true
      trrs:
          what: ceoloide/trrs_pj320a
          where:
            ref: matrix_inner_top
            shift: [26.6, -48]
            rotate: -90
          params:
            reversible: true
      batt_plug:
        what: ceoloide/battery_connector_jst_ph_2
        where :
          ref: matrix_inner_bottom
          shift: [5,-11]
          rotate: 90
        params:
          reversible: true
      