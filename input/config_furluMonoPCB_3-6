meta:
  engine: 4.1.0
units:
  # Proxy Spacing Variables
  kx: cx
  ky: cy
  # Padding Variables
  px: kx + 2
  py: ky +2
  #keycaps size
  screwSize: 1.5
  screwsupport: 5
points:
  zones:
    matrix:
      key:
        padding: 1ky
        spread: 1kx
      anchor:
        shift: [100, -100]
      columns:
        outter:
          key.spread: ky
          key.column_net: P0
          rows.top.skip: true
        pinky:
          key.spread: ky
          key.column_net: P2
          key.stagger: -5
        ring:
          key.spread: ky
          key.splay: -14
          key.stagger: 12
          key.origin: [0, -7.5]
          key.column_net: P3
        middle:
          key.spread: ky
          key.splay: -2
          key.stagger: 6
          key.origin: [0, -9]
          key.column_net: P4
        index:
          key.spread: ky
          key.splay: -6
          key.stagger: -8
          key.origin: [0, -1]
          key.column_net: P5
        inner:
          key.spread: ky
          key.stagger: -4
          key.column_net: P6
      rows:
        bottom:
          spread: kx
          row_net: P7
        home:
          spread: kx
          row_net: P8
        top:
          spread: kx
          row_net: P9
    thumbfan:
      anchor:
        ref: matrix_inner_bottom
        shift: [-kx+1, -23]
      columns:
        near:
          key.splay: 8
          key.column_net: P14
        home:
          key.spread: 19
          key.splay: -8
          key.origin: [-9.5, -9]
          key.column_net: P16
        far:
          key.spread: 19
          key.splay: -8
          key.origin: [-9.5, -9]
          key.column_net: P10
      rows:
        thumb:
          row_net: P15
  mirror:
    ref: matrix_inner_top
    distance: 2.5px

outlines:
  raw:
    - what: rectangle
      where: true
      size: [px, py]
  keys:
    - what: rectangle
      where: true
      bound: false
      size: [kx-0.5, ky-0.5]
  keycaps:
    - what: rectangle
      where: true
      size: [kx-0.5,ky-0.5]
  _key_slot_negative:
    - what: rectangle
      where: true
      size: 13.8

  _all :
    - what: polygon
      operation: stack
      points:
        - ref: matrix_pinky_bottom
          shift: [.5px, -.5py]
        - ref: matrix_pinky_bottom
          shift: [-.5px, -.5py]
        - ref: matrix_outter_bottom
          shift: [.5px-2, -.5py]
        - ref: matrix_outter_bottom
          shift: [-.5px, -.5py]
        - ref: matrix_outter_home
          shift: [-.5px, .5py]
        - ref: matrix_outter_home
          shift: [.5px-2, .5py]
        - ref: matrix_pinky_top
          shift: [-.5px, .5py]
        - ref: matrix_pinky_top
          shift: [.5px+7.5, .5py]
        - ref: matrix_ring_top
          shift: [-.5px, .5py]
        - ref: matrix_ring_top
          shift: [.5px-0.5, .5py]
        - ref: matrix_middle_top
          shift: [-.5px, .5py]
        - ref: matrix_middle_top
          shift: [.5px, .5py]
        - ref: matrix_middle_top
          shift: [.5px, .5py-6.8]
      #middle
        - ref: matrix_inner_top
          shift: [.5px, .5py+4]
        - ref: mirror_matrix_inner_top
          shift: [.5px, .5py+4]
      #right
        - ref: mirror_matrix_middle_top
          shift: [.5px, .5py-6.8]
        - ref: mirror_matrix_middle_top
          shift: [.5px, .5py]
        - ref: mirror_matrix_middle_top
          shift: [-.5px, .5py]
        - ref: mirror_matrix_ring_top
          shift: [.5px-0.5, .5py]
        - ref: mirror_matrix_ring_top
          shift: [-.5px, .5py]
        - ref: mirror_matrix_pinky_top
          shift: [.5px+7.5, .5py]
        - ref: mirror_matrix_pinky_top
          shift: [-.5px, .5py]
        - ref: mirror_matrix_outter_home
          shift: [.5px-2, .5py]
        - ref: mirror_matrix_outter_home
          shift: [-.5px, .5py]
        - ref: mirror_matrix_outter_bottom
          shift: [-.5px, -.5py]
        - ref: mirror_matrix_outter_bottom
          shift: [.5px-2, -.5py]
        - ref: mirror_matrix_pinky_bottom
          shift: [-.5px, -.5py]
        - ref: mirror_matrix_pinky_bottom
          shift: [.5px, -.5py]
      #bottom
        - ref: mirror_matrix_pinky_bottom
          shift: [.5px, .5py-5.5]
        - ref: mirror_thumbfan_near_thumb
          shift: [-.5px, .5py+6.5]
        - ref: mirror_thumbfan_near_thumb
          shift: [-.5px, -.5py]
        - ref: mirror_thumbfan_near_thumb
          shift: [.5px-1.5, -.5py]
        - ref: mirror_thumbfan_home_thumb
          shift: [.5px-1.5, -.5py]
        - ref: mirror_thumbfan_far_thumb
          shift: [.5px, -.5py]

        - ref: mirror_thumbfan_far_thumb
          shift: [.5px, -.5py+10]
        - ref: thumbfan_far_thumb
          shift: [.5px, -.5py+10]

        #- ref: mirror_thumbfan_far_thumb
        #  shift: [.5px, .5py]
        #- ref: thumbfan_far_thumb
        #  shift: [.5px, .5py]
        - ref: thumbfan_far_thumb
          shift: [.5px, -.5py]
        - ref: thumbfan_home_thumb
          shift: [.5px-1.5, -.5py]
        - ref: thumbfan_near_thumb
          shift: [.5px-1.5, -.5py]
        - ref: thumbfan_near_thumb
          shift: [-.5px, -.5py]
        - ref: thumbfan_near_thumb
          shift: [-.5px, .5py+6.5]
        - ref: matrix_pinky_bottom
          shift: [.5px, .5py-5.5]

  board_base:
    - name : _all
      fillet: 1

  wristrests :
    - what: polygon
      operation: stack
      points:
      #left
        - ref: matrix_pinky_home
          shift: [-.5px, -.5py]
        - ref: matrix_pinky_bottom
          shift: [-.5px, -.5py]
        - ref: matrix_pinky_bottom
          shift: [-.5px+10, -.5py-60]
        - ref: thumbfan_far_thumb
          shift: [.5px+5, .5py-50]
        - ref: thumbfan_far_thumb
          shift: [.5px, -.5py]
        - ref: matrix_index_home
          shift: [-.5px, -.5py]
      #right
        - ref: mirror_matrix_pinky_home
          shift: [-.5px, -.5py]
        - ref: mirror_matrix_pinky_bottom
          shift: [-.5px, -.5py]
        - ref: mirror_matrix_pinky_bottom
          shift: [-.5px+10, -.5py-60]
        - ref: mirror_thumbfan_far_thumb
          shift: [.5px+5, .5py-50]
        - ref: mirror_thumbfan_far_thumb
          shift: [.5px, -.5py]
        - ref: mirror_matrix_index_home
          shift: [-.5px, -.5py]
      expand: 1

  top_plate_board :
    - name : board_base
      expand: 3
      fillet: 1

  top_plate :
    - name : _key_slot_negative
    - operation : stack
      name : top_plate_board

pcbs:
  keyb_pcb:
    template: kicad8
    outlines:
      - outline : board_base
        #layer : Edge.Cuts
    footprints:
      choc_hotswap:
        what: ceoloide/switch_choc_v1_v2
        where: true
        params:
          reversible: false
          hotswap: true
          choc_v2_support: false
          include_corner_marks: true
          keycap_width: 18
          keycap_height: 18
          from: "{{column_net}}"
          to: "{{colrow}}"
      diode:
        what: ceoloide/diode_tht_sod123
        where: true
        params:
          from: "{{colrow}}"
          to: "{{row_net}}"
        adjust:
          shift: [0, -5]
      promicro:
        what: ceoloide/mcu_nice_nano
        where:
          ref.aggregate.parts: [matrix_pinky_home, mirror_matrix_pinky_home]
          shift: [0,-3.5]
      switch:
        what: ceoloide/power_switch_smd_side
        where: 
          ref.aggregate.parts: [matrix_pinky_home, mirror_matrix_pinky_home]
          shift: [0,-59.90]
          #shift: [0,-52.25]
          rotate: -90
      batt_plug:
        what: ceoloide/battery_connector_jst_ph_2
        where :
          ref.aggregate.parts: [matrix_pinky_home, mirror_matrix_pinky_home]
          shift: [10,-55]
          #shift: [-13,-10]
          rotate: -100

cases:
  clipin_plate :
    - what: outline
      name: top_plate
      extrude: 1.2
      rotate: [0,0,0]
  box :
    - what: outline
      name: top_plate
      extrude : 5.2
    - operation : subtract
      name : board_base
      extrude : 4
